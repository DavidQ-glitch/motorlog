{
  "appId": "com.motorlog.app",
  "appName": "MotorLog",
  "webDir": "www",
  "backgroundColor": "#0f172a",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#0f172a",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0f172a"
    },
    "CapacitorUpdater": {
      "autoUpdate": false
    }
  }
}